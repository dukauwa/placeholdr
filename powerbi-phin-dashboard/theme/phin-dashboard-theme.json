{
  "name": "PHIN Dashboard",
  "dataColors": [
    "#2a78d6",
    "#eb6834",
    "#1baf7a",
    "#eda100",
    "#e87ba4",
    "#008300",
    "#4a3aa7",
    "#e34948"
  ],
  "good": "#0ca30c",
  "neutral": "#fab219",
  "bad": "#d03b3b",
  "maximum": "#0d366b",
  "center": "#3987e5",
  "minimum": "#cde2fb",
  "background": "#fcfcfb",
  "foreground": "#0b0b0b",
  "tableAccent": "#2a78d6",
  "textClasses": {
    "title": { "color": "#0b0b0b", "fontFace": "Segoe UI Semibold", "fontSize": 14 },
    "label": { "color": "#52514e", "fontFace": "Segoe UI", "fontSize": 10 },
    "callout": { "color": "#0b0b0b", "fontFace": "Segoe UI", "fontSize": 28 },
    "header": { "color": "#0b0b0b", "fontFace": "Segoe UI Semibold", "fontSize": 12 }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#fcfcfb" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#e1e0d9" } }, "radius": 6 }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#0b0b0b" } }, "alignment": "left" }],
        "categoryAxis": [{
          "labelColor": { "solid": { "color": "#898781" } },
          "titleColor": { "solid": { "color": "#52514e" } },
          "gridlineColor": { "solid": { "color": "#e1e0d9" } },
          "gridlineStyle": "solid"
        }],
        "valueAxis": [{
          "labelColor": { "solid": { "color": "#898781" } },
          "titleColor": { "solid": { "color": "#52514e" } },
          "gridlineColor": { "solid": { "color": "#e1e0d9" } },
          "gridlineStyle": "solid"
        }],
        "legend": [{ "labelColor": { "solid": { "color": "#52514e" } }, "position": "Top" }],
        "labels": [{ "color": { "solid": { "color": "#52514e" } } }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#f9f9f7" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#f9f9f7" } } }]
      }
    }
  }
}
